+func TestConcurrentRevisionConflictAndSessionIsolation(t *testing.T) {
+	r := registry(t)
+	a, b := session(t, r, "a", "ZZZZ"), session(t, r, "b", "ZZZZ")
+	a.ObserveFlight(flight(), true)
+	b.ObserveFlight(flight(), true)
+	var successes atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if _, err := a.Execute(binding(a), Command{Kind: Move, Callsign: "DEMO123", Bay: "RUNWAY", ExpectedRevision: 1}); err == nil {
+				successes.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	if successes.Load() != 1 {
+		t.Fatalf("expected one winner, got %d", successes.Load())
+	}
+	for _, s := range []*Session{a, b} {
+		wg.Add(1)
+		go func(s *Session) {
+			defer wg.Done()
+			for i := 0; i < 100; i++ {
+				if _, err := s.ObserveFlight(flight(), true); err != nil {
+					t.Error(err)
+				}
+			}
+		}(s)
+	}
+	wg.Wait()
+	as, _ := a.Snapshot("DEMO123")
+	bs, _ := b.Snapshot("DEMO123")
+	if as.Bay != "RUNWAY" || bs.Bay != "HOLD" || !as.Annotations["review_required"] || bs.Annotations["review_required"] {
+		t.Fatal("concurrent session state leaked")
+	}
+}
