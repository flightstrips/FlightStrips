+	snapshot.Annotations["review_required"] = false
+	*snapshot.State = "BAD"
+	stored, _ := a.Snapshot(f.Callsign)
+	if !stored.Annotations["review_required"] || *stored.State == "BAD" {
+		t.Fatal("snapshot aliases session state")
