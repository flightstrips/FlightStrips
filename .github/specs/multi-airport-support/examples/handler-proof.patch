+func TestEKCHAdapterUsesExistingBayLogic(t *testing.T) {
+	r := registry(t)
+	h := r.airports["EKCH"].handler
+	for _, bay := range []string{"TAXI", "TAXI_LWR", "TAXI_TWR", "DEPART", "AIRBORNE", "HIDDEN_DEP"} {
+		for _, state := range []string{"", "TAXI", "LINEUP", "DEPA", "PUSH"} {
+			for _, gnd := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/%s/%t", bay, state, gnd), func(t *testing.T) {
+					f := flight()
+					f.GroundState = state
+					old := database.Strip{Origin: f.Origin, Destination: f.Destination, Bay: bay}
+					want := shared.GetDepartureBay(*f, &old, 200, "EKCH", gnd)
+					got, err := h.decide(Strip{Origin: f.Origin, Destination: f.Destination, Bay: bay, Revision: 1}, event{kind: observe, flight: f, groundOnline: gnd})
+					if err != nil || got.bay != want || got.groundState != nil {
+						t.Fatalf("adapter differs: %+v vs %s: %v", got, want, err)
+					}
+				})
+			}
+		}
+		got, err := h.decide(Strip{}, event{kind: Move, bay: bay})
+		want := shared.GetGroundState(bay)
+		if err != nil || (got.groundState == nil) != (want == "") || (got.groundState != nil && *got.groundState != want) {
+			t.Fatal("movement mapping differs")
+		}
+	}
+	// Explicit regression checks beyond delegating to the same helper.
+	for _, tc := range []struct {
+		bay  string
+		gnd  bool
+		want string
+	}{{"TAXI_LWR", true, "TAXI_LWR"}, {"TAXI_TWR", true, "TAXI_TWR"}, {"TAXI", false, "TAXI_LWR"}, {"DEPART", true, "DEPART"}, {"AIRBORNE", true, "AIRBORNE"}} {
+		got, _ := h.decide(Strip{Origin: "EKCH", Destination: "ZZZZ", Bay: tc.bay, Revision: 1}, event{kind: observe, flight: flight(), groundOnline: tc.gnd})
+		if got.bay != tc.want {
+			t.Fatalf("%+v became %s", tc, got.bay)
+		}
+	}
+}
