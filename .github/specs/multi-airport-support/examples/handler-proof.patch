+func TestRegistryIDsMatchConfigurationSchema(t *testing.T) {
+	data, err := os.ReadFile(filepath.Join("..", "..", "..", ".github", "specs", "multi-airport-support", "schema", "airport-configuration.schema.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var schema struct {
+		Definitions map[string]struct {
+			OneOf []struct {
+				Properties struct {
+					Handler struct {
+						Const string `json:"const"`
+					} `json:"handler"`
+				} `json:"properties"`
+			} `json:"oneOf"`
+		} `json:"$defs"`
+	}
+	if err := json.Unmarshal(data, &schema); err != nil {
+		t.Fatal(err)
+	}
+	factories := handlerFactories()
+	branches := schema.Definitions["workflow"].OneOf
+	if len(branches) != len(factories) {
+		t.Fatal("schema and compiled registry size differ")
+	}
+	for _, branch := range branches {
+		if factories[branch.Properties.Handler.Const] == nil {
+			t.Fatalf("schema handler has no factory: %s", branch.Properties.Handler.Const)
+		}
+	}
+}
