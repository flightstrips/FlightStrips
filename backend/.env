#SERVER_ADDR=127.0.0.1:8090

OIDC_AUTHORITY=https://auth.flightstrips.dk/.well-known/jwks.json
OIDC_SIGNING_ALGO=RS256
OIDC_AUDIENCE=backend-dev

# Log level: DEBUG, INFO (default), WARN, ERROR
LOG_LEVEL=INFO

# Three local NATS nodes; all backend processes share this explicit effect ring.
NATS_URLS=nats://backend:backend-local-only@127.0.0.1:4222,nats://backend:backend-local-only@127.0.0.1:4223,nats://backend:backend-local-only@127.0.0.1:4224
NATS_EFFECT_ACTIVE_KEY_ID=v1
NATS_EFFECT_KEY_FILES=v1=.local-secrets/effects-v1.key
NATS_AIRPORTS=EKCH
ENABLE_TEST_TOOLS=false
# Local fixture covers A320, B738 and C172; override with your full GRPlugin data.
GRPLUGIN_ICAO_AIRCRAFT_JSON=config/test/ICAO_Aircraft.json
