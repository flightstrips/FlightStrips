  "issue": 887,
  "requirement": "Startup estimates must never become automatic landing-slot commitments or be protected by holding, Stable, Superstable or TMA entry.",
  "recorded_case": {
    "callsign": "SAS506",
    "departure": "EGLL",
    "destination": "EKCH",
    "alternate": "EKBI",
    "first_observed_airborne_at": "2026-07-20T18:10:26.7815415Z",
    "filed_eet_seconds": 5940,
    "preliminary_eta": "2026-07-20T19:49:26.7815415Z"
  },
  "cause": "The first observed airborne time plus the full filed EET was used for advisory timing. It was incorrectly admitted into the automatic landing sequence. The old slot then survived the replacement of the preliminary prediction with physical route timing and acquired holding/freeze protection.",
  "fix": [
    "Preliminary predictions are excluded from automatic sequencing.",
    "Preliminary predictions cannot activate holding-slot protection, TMA capture or Superstable capture.",
    "Legacy automatic preliminary slots/freezes are discarded before reconciliation accepts a physical prediction and before resequencing.",
    "Explicit manual timing and accepted physical commitments retained through outages remain protected."
  ],
